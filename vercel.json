{
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{app/**,processed/embeddings/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/ready",
      "destination": "/api/index.py"
    },
    {
      "source": "/version",
      "destination": "/api/index.py"
    },
    {
      "source": "/ping",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/redoc",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/|health|ready|version|ping|docs|redoc|assets/|favicon|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}

